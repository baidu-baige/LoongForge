# Copy this file to an operator-managed path on a target runner.
# Do not commit the copy or include credentials in workflow logs.

LOONGFORGE_BASELINE_LLM_VLM=A800
LOONGFORGE_BASELINE_EMBODIED=P6K
LOONGFORGE_HOST_DATA_ROOT=/path/to/runner-data
LOONGFORGE_CONTAINER_DATA_ROOT=/workspace/ci-data
LOONGFORGE_HOST_OUTPUT_ROOT=/path/to/runner-logs
LOONGFORGE_CONTAINER_OUTPUT_ROOT=/workspace/ci-output
LOONGFORGE_CONTAINER_SOURCE=/workspace/LoongForge
LOONGFORGE_CONTAINER_SOURCE_MOUNT=/workspace/LoongForge-source
LOONGFORGE_CONTAINER_RETENTION_HOURS=24
LOONGFORGE_CANDIDATE_RETENTION_HOURS=24
LOONGFORGE_RUNNER_LOG_ROOT=/path/to/runner-run-logs
TRITON_LIBCUDA_PATH=/path/to/triton/libcuda

# Regression hooks.
LOONGFORGE_PULL_IMAGE=true
LOONGFORGE_DEFAULT_IMAGE=registry.example.internal/loongforge/ci-default:latest
# Docker installations without the NVIDIA runtime can use the NVIDIA CDI device.
LOONGFORGE_GPU_DEVICE=nvidia.com/gpu=all

# Optional runner-local proxy settings. Keep these out of the repository and
# set them in the Actions runner service environment when external access is
# required. The build and regression hooks pass non-empty values through.
# HTTP_PROXY=http://proxy.example.internal:8080
# HTTPS_PROXY=http://proxy.example.internal:8080
# NO_PROXY=127.0.0.1,localhost,.internal.example
# http_proxy=$HTTP_PROXY
# https_proxy=$HTTPS_PROXY
# no_proxy=$NO_PROXY

# Optional local candidate image repository name. It is never pushed.
CI_CANDIDATE_IMAGE_REPOSITORY=loongforge-ci
CANDIDATE_TAG_PREFIX=pr

# Candidate images are always local to the suite runner and are never pushed.
# IMAGE_DOCKERFILE=/path/to/Dockerfile
# IMAGE_BASE_IMAGE=...

# Optional BuildKit secrets for internal mirrors. These files are managed on
# each runner and must not be committed or printed in workflow logs.
# IMAGE_APT_SOURCES=/opt/loongforge-ci/internal-build/apt/sources.list
# IMAGE_PIP_CONFIG=/opt/loongforge-ci/internal-build/pip/pip.conf
# IMAGE_SOURCE_MANIFEST=/opt/loongforge-ci/internal-build/bos/source-manifest.env
