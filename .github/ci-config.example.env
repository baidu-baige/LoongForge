# Copy this file to an operator-managed path on a target runner.
# Do not commit the copy or include credentials in workflow logs.

LOONGFORGE_BASELINE_A=A800
LOONGFORGE_BASELINE_P=BZZ
LOONGFORGE_CHIP_A=A800
LOONGFORGE_CHIP_P=BZZ
TRAINING_LOG_PATH=/path/to/logs
PFS_PATH=/path/to/pfs
LOONGFORGE_CONTAINER_SOURCE=/workspace/LoongForge
LOONGFORGE_CONTAINER_SOURCE_MOUNT=/workspace/LoongForge-source
LOONGFORGE_CONTAINER_RETENTION_HOURS=24

# Regression hooks.
LOONGFORGE_REGRESSION_RUNNER=/opt/loongforge-ci/bin/run-isolated-regression
LOONGFORGE_PULL_IMAGE=true
LOONGFORGE_DEFAULT_IMAGE=iregistry.example.internal/loongforge/ci-ampere:default
LOONGFORGE_BOOTSTRAP_IMAGE=iregistry.example.internal/loongforge/ci-ampere:bootstrap

# Image hook overrides. The repository-provided hooks are used by default.
# LOONGFORGE_IMAGE_BUILDER=/opt/loongforge-ci/bin/build-candidate-image
# LOONGFORGE_IMAGE_PROMOTER=/opt/loongforge-ci/bin/promote-candidate-image

# Image repository settings consumed by the hooks.
IMAGE_REGISTRY=iregistry.example.internal
IMAGE_REPOSITORY_A=loongforge/ci-ampere
IMAGE_REPOSITORY_H=loongforge/ci-hopper
IMAGE_REPOSITORY_P=loongforge/ci-blackwell
IMAGE_DEFAULT_TAG_A=default
IMAGE_DEFAULT_TAG_H=default
IMAGE_DEFAULT_TAG_P=default
CANDIDATE_TAG_PREFIX=pr

# Optional local validation switches. Keep IMAGE_PUSH=true in production.
# IMAGE_DOCKERFILE=/path/to/Dockerfile
# IMAGE_BASE_IMAGE=...
# IMAGE_PUSH=false
# IMAGE_DRY_RUN=true

# Optional BuildKit secrets for internal mirrors. These files are managed on
# each runner and must not be committed or printed in workflow logs.
# IMAGE_APT_SOURCES=/opt/loongforge-ci/internal-build/apt/sources.list
# IMAGE_PIP_CONFIG=/opt/loongforge-ci/internal-build/pip/pip.conf
# IMAGE_SOURCE_MANIFEST=/opt/loongforge-ci/internal-build/bos/source-manifest.env
